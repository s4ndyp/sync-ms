# syntax=docker/dockerfile:1
# syncms-disk-probe — sidecar for Syncthing (same folder volume paths as Syncthing container).

FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/syncms-disk-probe ./cmd/syncms-disk-probe
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /syncms-disk-probe ./cmd/syncms-disk-probe

FROM alpine:3.21
RUN apk add --no-cache ca-certificates \
    && addgroup -S probe \
    && adduser -S probe -G probe
COPY --from=build /syncms-disk-probe /usr/local/bin/syncms-disk-probe
USER probe
EXPOSE 8765
ENTRYPOINT ["/usr/local/bin/syncms-disk-probe"]
