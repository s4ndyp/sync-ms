# /etc/sync-ms/folder-disk.env — agent op elke Syncthing-host
#
# URL van je Sync-MS dashboard (PocketBase), bereikbaar vanaf deze machine:
SYNC_MS_URL=https://sync-ms.example:8096

# Lokale Syncthing GUI/API (standaard poort 8384):
SYNCTHING_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY=

# Optioneel: PocketBase record-id van deze instance (anders koppeling via Syncthing device ID):
# SYNC_MS_INSTANCE_ID=

# Optioneel: extra paden buiten Syncthing-config (regels: folder_id|label|pad):
# EXTRA_PATHS_FILE=/etc/sync-ms/folder-disk-extra.paths
